# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=crm_user
DB_PASSWORD=crm_pass
DB_DATABASE=crm_db

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@crm.dev
PGADMIN_DEFAULT_PASSWORD=admin123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3 compatível)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=crm_access
MINIO_SECRET_KEY=crm_secret123
MINIO_BUCKET=crm-uploads

# JWT
JWT_SECRET=mude_esta_chave_em_producao
JWT_EXPIRES_IN=8h

# Criptografia de parâmetros sensíveis (SMTP pass, etc.)
PARAMS_ENCRYPTION_KEY=chave_aes_256_32_caracteres_aqui

# App
NODE_ENV=development
PORT=3000
# SMTP e demais configurações operacionais ficam na tabela `parametros` do banco
# FRONTEND_URL é fallback de dev; em produção usar parâmetro sistema.url_frontend
FRONTEND_URL=http://localhost:4200
